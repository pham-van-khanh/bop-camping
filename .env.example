APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ảnh/video sản phẩm, camping-spot, category, banner, review.
# local (mặc định) = lưu ở storage/app/public như trước.
# s3 = lưu trên S3 (hoặc dịch vụ tương thích S3: DO Spaces, Cloudflare R2, MinIO...) — cần điền đủ AWS_* dưới đây.
MEDIA_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# URL public để truy cập file (vd: https://your-bucket.s3.amazonaws.com, hoặc CDN/CloudFront trước bucket).
AWS_URL=
# Chỉ cần khi dùng dịch vụ tương thích S3 khác AWS thật (DO Spaces, R2, MinIO...). Để trống nếu dùng AWS S3 thật.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Góp ý (Epic 2) — mail báo admin + mail phản hồi khách. Trống = dùng mặc định.
MAIL_ADMIN_ADDRESS=
# Đặt MAIL_REPLY_MAILER=reply để gửi phản hồi bằng tài khoản SMTP riêng bên dưới.
MAIL_REPLY_MAILER=
MAIL_REPLY_HOST=
MAIL_REPLY_PORT=
MAIL_REPLY_USERNAME=
MAIL_REPLY_PASSWORD=
MAIL_REPLY_FROM_ADDRESS=
MAIL_REPLY_FROM_NAME=
