# Template .env cho PRODUCTION — copy thành .env trên server rồi điền giá trị thật.
# KHÔNG commit file .env thật (đã được .gitignore bỏ qua). File .example này an toàn để commit.
# Chi tiết deploy: artifacts/deploy_runbook.md

APP_NAME="BopCamping"
APP_ENV=production
APP_KEY=                       # chạy: php artisan key:generate
APP_DEBUG=false
APP_URL=https://bopcamping.vn  # đổi thành domain thật

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                # prod chỉ ghi lỗi, tránh log ồn

# --- Database: MySQL 8 ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bopcamping
DB_USERNAME=bopcamping
DB_PASSWORD=                   # mật khẩu DB mạnh

# --- Session (HTTPS) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=bopcamping.vn   # đổi thành domain thật

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public         # ảnh sản phẩm/review qua public disk + storage:link
QUEUE_CONNECTION=database      # cần Supervisor giữ queue:work chạy (xem runbook)
CACHE_STORE=database

# --- Tai khoan admin (seed lan dau) ---
ADMIN_PHONE=0976544370
ADMIN_EMAIL=admin@bopcamping.vn
ADMIN_PASSWORD=                # BAT BUOC dat — mat khau admin manh (khong de trong o prod)

# --- Email SMTP that (OTP dang nhap, xac nhan don, moi danh gia) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com       # vd Gmail; hoac smtp Brevo/Resend
MAIL_PORT=587
MAIL_USERNAME=                 # email gui
MAIL_PASSWORD=                 # App Password (Gmail) / API key SMTP
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@bopcamping.vn"
MAIL_FROM_NAME="BopCamping"

VITE_APP_NAME="${APP_NAME}"
